<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
    "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class catalog="eduelorrieta"
           name="com.example.ProyectoSpringboot.modelo.Users"
           optimistic-lock="none"
           table="users">

        <id name="id" type="java.lang.Integer">
            <column name="id"/>
            <generator class="identity"/>
        </id>

        <many-to-one class="com.example.ProyectoSpringboot.modelo.Tipos"
                     fetch="join"
                     name="tipos">
            <column name="tipo_id" not-null="true"/>
        </many-to-one>

        <property name="email" type="string">
            <column length="100" name="email" not-null="true" unique="true"/>
        </property>

        <property name="username" type="string">
            <column length="50" name="username" not-null="true" unique="true"/>
        </property>

        <property name="password" type="string">
            <column length="255" name="password" not-null="true"/>
        </property>

        <property name="nombre" type="string">
            <column length="50" name="nombre"/>
        </property>

        <property name="apellidos" type="string">
            <column length="100" name="apellidos"/>
        </property>

        <property name="dni" type="string">
            <column length="20" name="dni"/>
        </property>

        <property name="direccion" type="string">
            <column length="255" name="direccion"/>
        </property>

        <property name="telefono1" type="string">
            <column length="20" name="telefono1"/>
        </property>

        <property name="telefono2" type="string">
            <column length="20" name="telefono2"/>
        </property>

        <property name="argazkiaUrl" type="string">
            <column length="255" name="argazkia_url"/>
        </property>

        <property name="createdAt" type="timestamp">
            <column length="19" name="created_at"/>
        </property>

        <property name="updatedAt" type="timestamp">
            <column length="19" name="updated_at"/>
        </property>

        <!-- Matriculaciones -->
        <set fetch="select"
             inverse="true"
             lazy="true"
             name="matriculaciones"
             table="matriculaciones">

            <key>
                <column name="alum_id" not-null="true"/>
            </key>

            <one-to-many class="com.example.ProyectoSpringboot.modelo.Matriculaciones"/>
        </set>

        <!-- Reuniones como alumno -->
        <set fetch="select"
             inverse="true"
             lazy="true"
             name="reunionesForAlumnoId"
             table="reuniones">

            <key>
                <column name="alumno_id"/>
            </key>

            <one-to-many class="com.example.ProyectoSpringboot.modelo.Reuniones"/>
        </set>

        <!-- Horarios -->
        <set fetch="select"
             inverse="true"
             lazy="true"
             name="horarios"
             table="horarios">

            <key>
                <column name="profe_id" not-null="true"/>
            </key>

            <one-to-many class="com.example.ProyectoSpringboot.modelo.Horarios"/>
        </set>

        <!-- Reuniones como profesor -->
        <set fetch="select"
             inverse="true"
             lazy="true"
             name="reunionesForProfesorId"
             table="reuniones">

            <key>
                <column name="profesor_id"/>
            </key>

            <one-to-many class="com.example.ProyectoSpringboot.modelo.Reuniones"/>
        </set>

    </class>
</hibernate-mapping>
