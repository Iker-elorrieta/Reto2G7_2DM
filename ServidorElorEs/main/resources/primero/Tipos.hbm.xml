<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
    "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class catalog="eduelorrieta"
           name="com.example.ProyectoSpringboot.modelo.Tipos"
           optimistic-lock="none"
           table="tipos">

        <id name="id" type="java.lang.Integer">
            <column name="id"/>
            <generator class="identity"/>
        </id>

        <property name="name" type="string">
            <column length="50" name="name" not-null="true" unique="true"/>
        </property>

        <property name="nameEu" type="string">
            <column length="50" name="name_eu"/>
        </property>

        <set fetch="select"
             inverse="true"
             lazy="true"
             name="users"
             table="users">

            <key>
                <column name="tipo_id" not-null="true"/>
            </key>

            <one-to-many class="com.example.ProyectoSpringboot.modelo.Users"/>
        </set>

    </class>
</hibernate-mapping>
