<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
    "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class catalog="eduelorrieta"
           name="com.example.ProyectoSpringboot.modelo.Ciclos"
           optimistic-lock="none"
           table="ciclos">

        <id name="id" type="java.lang.Integer">
            <column name="id"/>
            <generator class="identity"/>
        </id>

        <property name="nombre" type="string">
            <column length="200" name="nombre" not-null="true"/>
        </property>

        <!-- Relación con Modulos -->
        <set fetch="select"
             inverse="true"
             lazy="true"
             name="modulos"
             table="modulos">

            <key>
                <column name="ciclo_id" not-null="true"/>
            </key>

            <one-to-many class="com.example.ProyectoSpringboot.modelo.Modulos"/>
        </set>

        <!-- Relación con Matriculaciones -->
        <set fetch="select"
             inverse="true"
             lazy="true"
             name="matriculaciones"
             table="matriculaciones">

            <key>
                <column name="ciclo_id" not-null="true"/>
            </key>

            <one-to-many class="com.example.ProyectoSpringboot.modelo.Matriculaciones"/>
        </set>

    </class>
</hibernate-mapping>
